rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isAuthenticated() && (getUserData().role == 'super_admin');
    }

    function hasRole(role) {
      return isAuthenticated() && (getUserData().role == role || isSuperAdmin());
    }

    // Rules for users collection (Doctor profiles)
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if isAuthenticated() && (request.auth.uid == userId || hasRole('hospital_admin') || isSuperAdmin());
      allow delete: if isAuthenticated() && (hasRole('hospital_admin') || isSuperAdmin());
    }

    // Rules for doctors collection
    match /doctors/{doctorId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Rules for hospitals collection
    match /hospitals/{hospitalId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Rules for patients collection
    match /patients/{patientId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated() && (
        hasRole('doctor') || 
        hasRole('hospital_admin') || 
        hasRole('nurse')
      );
      allow delete: if isAuthenticated() && (
        hasRole('doctor') || 
        hasRole('hospital_admin')
      );
    }

    // Rules for critical_patients collection
    match /critical_patients/{patientId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Rules for medical_records collection
    match /medical_records/{recordId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Rules for treatments collection
    match /treatments/{treatmentId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Rules for vitals_history collection
    match /vitals_history/{vitalId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Rules for alerts collection
    match /alerts/{alertId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Rules for cameras collection
    match /cameras/{cameraId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Rules for notifications collection
    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Rules for activities collection
    match /activities/{activityId} {
      allow read, write: if isAuthenticated();
    }

    // Rules for audit logs and system configs
    match /audit_logs/{id} { allow read, write: if isAuthenticated(); }
    match /backups/{id} { allow read, write: if isAuthenticated(); }
    match /api_configs/{id} { allow read, write: if isAuthenticated(); }
    match /security_logs/{id} { allow read, write: if isAuthenticated(); }

    // Rules for staff and scheduling
    match /schedules/{id} { allow read, write: if isAuthenticated(); }
    match /appointments/{id} { allow read, write: if isAuthenticated(); }
    match /shifts/{id} { allow read, write: if isAuthenticated(); }
    match /mar_records/{id} { allow read, write: if isAuthenticated(); }

    // Rules for emergency code blue
    match /code_blue/{id} { allow read, write: if isAuthenticated(); }

    // Rules for clinical logs
    match /admissions/{id} { allow read, write: if isAuthenticated(); }
    match /discharges/{id} { allow read, write: if isAuthenticated(); }
    match /transfers/{id} { allow read, write: if isAuthenticated(); }
    match /prescriptions/{id} { allow read, write: if isAuthenticated(); }
    match /lab_reports/{id} { allow read, write: if isAuthenticated(); }
    match /scan_reports/{id} { allow read, write: if isAuthenticated(); }

    // Rules for department infrastructure
    match /departments/{id} { allow read, write: if isAuthenticated(); }
    match /rooms/{id} { allow read, write: if isAuthenticated(); }
    match /beds/{id} { allow read, write: if isAuthenticated(); }
  }
}
